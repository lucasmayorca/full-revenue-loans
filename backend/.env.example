NODE_ENV=development
PORT=3001

# ── DEMO MODE ──────────────────────────────────────────────────────────────────
# Con DEMO_MODE=true no se necesitan credenciales reales de Google ni Syntage.
# Los datos de underwriting (Syntage + Google) se generan automáticamente con
# valores realistas de demo. El flujo completo funciona end-to-end.
DEMO_MODE=true

# Umbral de ingresos mensuales (MXN) para evaluación de underwriting
APPROVAL_THRESHOLD=50000

# ── Syntage API (solo necesario si DEMO_MODE=false) ───────────────────────────
SYNTAGE_BASE_URL=https://api.syntage.com
SYNTAGE_API_KEY=
SYNTAGE_TIMEOUT_MS=10000

# ── Google OAuth (solo necesario si DEMO_MODE=false) ─────────────────────────
# Crear credenciales en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/full-revenue/oauth/google/callback

# ── GCP (solo necesario si DEMO_MODE=false) ───────────────────────────────────
GCP_PROJECT_ID=

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
